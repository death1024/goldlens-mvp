{
  "name": "goldlens",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "pnpm --filter @goldlens/web dev",
    "build": "pnpm --filter @goldlens/web build",
    "start": "pnpm --filter @goldlens/web start",
    "test": "npm run test --workspaces --if-present && node tests/smoke.mjs",
    "check": "pnpm --filter @goldlens/core check && pnpm --filter @goldlens/web check",
    "seed": "pnpm --filter @goldlens/db seed",
    "legacy:start": "node mvp/server.mjs",
    "test:web": "pnpm --filter @goldlens/web test",
    "test:e2e": "node scripts/e2e-demo.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
